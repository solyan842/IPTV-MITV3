<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/nativeSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:focusable="true"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:focusable="true"
        android:keepScreenOn="true"
        app:surface_type="surface_view"
        app:use_controller="true"
        app:show_buffering="when_playing" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#B5101114">

        <Button
            android:id="@+id/sourceButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/compact_button_bg"
            android:text="NGUỒN"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:focusable="true" />

        <Button
            android:id="@+id/channelsButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/compact_button_bg"
            android:text="KÊNH"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:focusable="true" />

        <TextView
            android:id="@+id/currentListText"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chưa chọn playlist"
            android:textColor="@color/text_soft"
            android:textSize="13sp" />

        <Button
            android:id="@+id/safeButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/compact_button_bg"
            android:text="1080 HW"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channelDrawer"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:paddingTop="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/drawerTitle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:text="DANH SÁCH KÊNH"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="8dp"
        android:background="#B5101114"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:maxWidth="900dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Sẵn sàng"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
