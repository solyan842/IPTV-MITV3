<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:hint="URL playlist .m3u hoặc stream .m3u8/.mpd"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:backgroundTint="@color/accent"
            android:inputType="textUri" />

        <Button
            android:id="@+id/loadButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="MỞ URL"
            android:focusable="true" />

        <Button
            android:id="@+id/openFileButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="MỞ FILE"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp">

        <Button
            android:id="@+id/savedListsButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="LIST ĐÃ LƯU"
            android:focusable="true" />

        <TextView
            android:id="@+id/currentListText"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:text="Chưa chọn playlist"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/safeButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="MiTV3 HW 1080"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:text="Sẵn sàng"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/channelList"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="@color/panel"
            android:divider="#30333A"
            android:dividerHeight="1dp"
            android:focusable="true"
            android:nextFocusRight="@id/playerView" />

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="#000000"
            android:focusable="true"
            android:keepScreenOn="true"
            app:surface_type="surface_view"
            app:use_controller="true"
            app:show_buffering="when_playing" />
    </LinearLayout>
</LinearLayout>
